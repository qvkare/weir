{
  "name": "@weir/chain",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal NEAR JSON-RPC client, the Weir contract port (on chain and on the engine model), the USDC token calls and a NEAR Intents quote client.",
  "type": "module",
  "exports": {
    ".": "./src/mod.ts",
    "./guest": "./src/guest.ts"
  },
  "scripts": {
    "test": "node --test --disable-warning=ExperimentalWarning \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p .",
    "quote": "node --disable-warning=ExperimentalWarning src/cli.ts quote"
  },
  "dependencies": {
    "@noble/ed25519": "3.2.0",
    "@weir/engine": "workspace:*"
  },
  "devDependencies": {
    "@near-js/crypto": "2.5.1",
    "@near-js/transactions": "2.5.1",
    "@types/node": "22.18.0",
    "typescript": "^5.9.3"
  }
}
