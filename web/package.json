{
  "name": "@weir/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:model": "WEIR_MODEL=1 next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "node --test --disable-warning=ExperimentalWarning \"lib/**/*.test.ts\" \"worker/**/*.test.ts\"",
    "smoke": "node --disable-warning=ExperimentalWarning scripts/smoke.ts",
    "build:worker": "next build",
    "preview": "next build && wrangler dev --port 8787",
    "deploy": "next build && wrangler deploy"
  },
  "dependencies": {
    "@hot-labs/near-connect": "0.12.0",
    "@tailwindcss/postcss": "4.1.14",
    "@weir/agents": "workspace:*",
    "@weir/chain": "workspace:*",
    "@weir/engine": "workspace:*",
    "@weir/index": "workspace:*",
    "clsx": "2.1.1",
    "motion": "12.23.24",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.3.1",
    "tailwindcss": "4.1.14"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "7.0.2",
    "wrangler": "4.158.0"
  }
}
