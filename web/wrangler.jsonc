// The Weir site on Cloudflare Workers, free plan. Every page is a static file in out/ (written by
// `next build`, a static export); Cloudflare serves those without running the Worker. The Worker
// (worker/index.ts) runs only for the paths in run_worker_first: the per-market pages, to redirect
// ?m=<market> to /m/<market>/..., the three /api routes, and old /m/ names. It holds no secret.
// Keep run_worker_first equal to WORKER_FIRST in worker/route.ts (worker/route.test.ts checks).
// Build: `pnpm --filter @weir/web run build:worker`. Deploy: see README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weir",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "assets": {
    "directory": "out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/auction", "/auction/book", "/auction/clearings", "/auction/prints", "/agents", "/proof", "/proof/solvency", "/proof/review", "/proof/record", "/how", "/simulate", "/api/*", "/m/h100-weekly", "/m/h100-weekly/*", "/m/weekly", "/m/weekly/*", "/m/fast", "/m/fast/*"]
  },
  "workers_dev": true,
  // The public address, with and without www. The workers.dev address keeps working beside it.
  "routes": [
    { "pattern": "tryweir.com", "custom_domain": true },
    { "pattern": "www.tryweir.com", "custom_domain": true }
  ],
  "preview_urls": false
}
