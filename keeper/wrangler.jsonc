// The Weir keeper: one SQLite-backed Durable Object holds the store and ticks every minute on
// its own alarm; the cron trigger only checks that the alarm is armed. Fits the Workers Free
// plan (see README, "Option 1"). Deploy with `pnpm --filter @weir/keeper exec wrangler deploy`
// after `wrangler login`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weir-keeper",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  // The public address. The workers.dev address keeps working beside it.
  "routes": [{ "pattern": "keeper.tryweir.com", "custom_domain": true }],
  // The watchdog: arms the object's alarm when none is armed. The ticks come from the alarm.
  "triggers": { "crons": ["* * * * *"] },
  "durable_objects": {
    "bindings": [{ "name": "KEEPER_OBJECT", "class_name": "KeeperObject" }]
  },
  // SQLite-backed: the only kind of Durable Object on the Free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["KeeperObject"] }],
  // Secrets, set with `wrangler secret bulk` or `wrangler secret put <NAME>`, never in this file:
  // REPORTERS, AGENTS, SWARM_SECRET, and optionally KEEPER.
  "vars": { "BUDGET": "40" },
  "observability": { "enabled": true }
}
