// The Weir keeper: every minute it posts the index on chain and runs the trading agents.
// Deploy with `pnpm --filter @weir/keeper exec wrangler deploy` (needs `wrangler login`; see README).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weir-keeper",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "triggers": { "crons": ["* * * * *"] },
  "kv_namespaces": [
    // PLACEHOLDER: replace with the id printed by `pnpm --filter @weir/keeper exec wrangler kv namespace create STORE`.
    { "binding": "STORE", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  // Secrets, set with `wrangler secret put <NAME>`, never in this file: REPORTERS, AGENTS, SWARM_SECRET.
  "vars": { "BUDGET": "40" },
  "observability": { "enabled": true }
}
