# Copy to keeper/.env (ignored by git) and fill in. Never commit real keys.
# The Worker reads the same names as secrets: `wrangler secret put REPORTERS`, etc.

# Accounts that sign report(bucket, price, bundle). Each must be in the contract's `reporters`.
REPORTERS='[{"account_id":"reporter-a.example.testnet","secret_key":"ed25519:<base58 secret key>"},{"account_id":"reporter-b.example.testnet","secret_key":"ed25519:<base58 secret key>"},{"account_id":"reporter-c.example.testnet","secret_key":"ed25519:<base58 secret key>"}]'

# Trading agents. role: buyer | seller | maker | noise. Optional settings per role are in README.md.
# Agents' keys need only AGENT_KEY_METHODS (commit, reveal, clear, mint, merge, settle, redeem).
# markets: optional list of market ids (h100-fast, h100-weekly, h200-weekly, a100-80-weekly); default all.
AGENTS='[{"account_id":"buyer-1.example.testnet","secret_key":"ed25519:<base58 secret key>","role":"buyer","need":40,"premium_bps":500},{"account_id":"seller-1.example.testnet","secret_key":"ed25519:<base58 secret key>","role":"seller","capacity":180,"premium_bps":500}]'

# Any long random string. Salts of sealed orders come from it: losing it loses unrevealed orders.
SWARM_SECRET='<long random string>'

# Optional housekeeping account with a function-call key for KEEPER_KEY_METHODS. It signs clear,
# settle, finalize_print, prune_print and prune_result. Without it nothing is pruned.
KEEPER='{"account_id":"keeper.example.testnet","secret_key":"ed25519:<base58 secret key>"}'
